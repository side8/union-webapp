---
import Layout from '../../layouts/Layout.astro'
import { env } from 'cloudflare:workers'
import {
  basicAuthOk,
  describeAge,
  OTP_ADDRESSES,
  otpKeyFor,
  secretMatches,
  type StoredOtp,
} from '../../lib/reviewer-otp'

// SSR-only — reads live KV at request time. Marketing pages stay static;
// this one opts out, same as /share/[token].
export const prerender = false

// Store-review and demo sign-in codes.
//
// Union has no password (sign-in emails a one-time code), and Play forbids
// reviewers using their own accounts while requiring credentials that are
// reusable and bypass a one-time PIN. Play's documented escape hatch for a
// credential that isn't a plain string is a static URL — this is it. Apple
// App Review and the demo/screenshots account use the same mechanism. See
// ../../lib/reviewer-otp.ts for the full rationale.
//
// ONE page serves all three addresses rather than one page each: it is one
// token, one password, and one Email Routing target to keep working, and a
// reviewer who mistypes the address still finds their code on the page they
// were given. The tradeoff is that a holder of this link can read all three
// codes — acceptable because every one of them is a Union-owned account
// with no real user data, and the page is already behind two gates.
//
// The URL path stays /play-review/* even though it now serves more than
// Play: the value is pasted into store consoles and written down in the
// runbooks, and a rename would silently break whichever one was missed.
//
// The URL secret is the only guard, so it must be a long random value held
// in REVIEWER_PAGE_TOKEN. A missing secret makes secretMatches() reject
// everything, i.e. the page fails CLOSED rather than becoming public.

// Astro v6 + @astrojs/cloudflare: bindings come from `cloudflare:workers`.
// Astro.locals.runtime.env was removed in v6 (accessing it throws) — the
// same trap that broke the share route.
const bindings = env as unknown as {
  REVIEWER_OTP?: KVNamespace
  REVIEWER_PAGE_TOKEN?: string
  REVIEWER_PAGE_USER?: string
  REVIEWER_PAGE_PASSWORD?: string
}

// Two independent gates, checked in this order on purpose.
//
// 1. URL token — a wrong token 404s BEFORE the password prompt, so the
//    page's existence is never revealed to someone guessing paths.
// 2. HTTP Basic auth — the password the reviewer is given. Basic is the
//    right fit here: Play's App access form has literal Username and
//    Password fields, and the browser renders the prompt natively.
//
// Keeping both is deliberate defence in depth: the URL is pasted into a
// Play Console field and may be seen by more people than intended, and
// the password still guards it if that link ever leaks.
const provided = Astro.params.token ?? ''
const tokenOk = secretMatches(provided, bindings.REVIEWER_PAGE_TOKEN ?? '')

const passwordOk =
  tokenOk &&
  basicAuthOk(
    Astro.request.headers.get('Authorization'),
    bindings.REVIEWER_PAGE_USER ?? '',
    bindings.REVIEWER_PAGE_PASSWORD ?? '',
  )

// One read per address. They are independent slots, so a miss on one must
// not hide the others.
let codes: { address: string; label: string; stored: StoredOtp | null }[] = []
let unavailable = false

if (passwordOk) {
  try {
    codes = await Promise.all(
      OTP_ADDRESSES.map(async ({ address, label }) => ({
        address,
        label,
        stored: await bindings.REVIEWER_OTP!.get<StoredOtp>(
          otpKeyFor(address),
          'json',
        ),
      })),
    )
  } catch {
    // Never 500 in front of a reviewer mid-review — show the waiting state
    // and let them retry, exactly as if no code had arrived yet.
    unavailable = true
    codes = OTP_ADDRESSES.map(({ address, label }) => ({
      address,
      label,
      stored: null,
    }))
  }
}

if (!tokenOk) {
  // Indistinguishable from a page that does not exist.
  Astro.response.status = 404
} else if (!passwordOk) {
  // Triggers the browser's native credentials prompt. The realm is
  // deliberately bland — it should not advertise what the page holds.
  Astro.response.status = 401
  Astro.response.headers.set('WWW-Authenticate', 'Basic realm="Restricted"')
}

// This page renders a live sign-in factor: it must never be indexed and
// must never be cached by any hop.
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive')
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0')
---

<Layout
  title="Sign-in code"
  description="Sign-in code for app review."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow, noarchive" />
  </Fragment>

  <main class="wrap">
    {!tokenOk && (
      <section>
        <h1>Not found</h1>
        <p>This page isn’t available.</p>
      </section>
    )}

    {tokenOk && !passwordOk && (
      <section>
        <h1>Sign in required</h1>
        <p>Enter the username and password supplied with this link.</p>
      </section>
    )}

    {passwordOk && (
      <section>
        <h1>Union sign-in codes</h1>
        <p class="lede">
          Enter your email address on the app’s sign-in screen, then read the
          matching code below.
        </p>

        {codes.map(({ address, label, stored }) => (
          <article class="slot">
            <h2>{label}</h2>
            <p class="address">{address}</p>

            {stored && (
              <>
                <p
                  class="code"
                  aria-label={`Sign-in code ${stored.code.split('').join(' ')}`}
                >
                  {stored.code}
                </p>
                <p class="meta">Received {describeAge(stored.receivedAt)}.</p>
              </>
            )}

            {!stored && (
              <p class="waiting">
                {unavailable
                  ? 'The code service is briefly unavailable. Please reload in a few seconds.'
                  : 'No code yet. Request one in the app, then reload this page.'}
              </p>
            )}
          </article>
        ))}

        <p class="meta">
          Codes expire after a short time. If sign-in fails, request a new
          code in the app and reload.
        </p>
      </section>
    )}
  </main>
</Layout>

<style>
  .wrap {
    max-width: 34rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  h1 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .lede {
    margin-bottom: 2rem;
  }
  /* Each address is a distinct block so three codes on one page can never
     be read off against the wrong address. */
  .slot {
    padding: 1.25rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
  }
  .slot h2 {
    font-size: 1rem;
    margin: 0;
  }
  .address {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
    opacity: 0.7;
    margin: 0.15rem 0 0.5rem;
    /* A long address must wrap rather than push the page sideways on a
       phone, which is what a reviewer is holding. */
    overflow-wrap: anywhere;
  }
  /* Large, spaced, tabular: the reviewer is copying this by eye onto a
     phone, so legibility matters more than styling. */
  .code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-size: clamp(2.5rem, 12vw, 4rem);
    letter-spacing: 0.15em;
    margin: 0 0 0.5rem;
  }
  .waiting {
    margin: 2rem 0;
  }
  .meta {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-top: 1rem;
  }
</style>
