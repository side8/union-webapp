{
  // Email Worker for the store-review and demo sign-in codes.
  //
  // Deploy from THIS directory:  npx wrangler deploy
  // (the root wrangler.jsonc is the Astro app — a different Worker.)
  //
  // Each address in OTP_ADDRESSES (src/lib/reviewer-otp.ts) needs its OWN
  // routing rule in the Cloudflare dashboard — there is no wildcard, and an
  // address with no rule simply never reaches this Worker, which looks
  // identical to "no code has arrived yet" on the page:
  //   Email > Email Routing > Routing rules > Create
  //     Custom address: reviewer.play@unionwith.app
  //     Action:         Send to a Worker -> union-reviewer-otp-inbox
  //   ...and the same for reviewer.apple@ and hannah@.
  //
  // The KV namespace below was created with:
  //   npx wrangler kv namespace create REVIEWER_OTP
  // The SAME namespace is bound to the union-webapp Worker (root
  // wrangler.jsonc) so the page can read what this Worker writes.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "union-reviewer-otp-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-18",
  "workers_dev": false,
  "preview_urls": false,
  // Same rationale as the root config: keep logs on so a silently
  // non-delivering reviewer alias is diagnosable rather than a mystery
  // during a live Play review.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "REVIEWER_OTP",
      "id": "0995f183d14a4def886eee6dc2a0247b"
    }
  ]
}
